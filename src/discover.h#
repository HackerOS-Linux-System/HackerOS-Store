fn safe_id(s: string) -> bool is
    return s != "" && !string_contains(s, "/") && !string_contains(s, "..")
end

fn flatpak_icon_script(id: string) -> string is
    return "ID=" + shx::q(id) + "; for b in \"$HOME/.local/share/flatpak/appstream/flathub\" /var/lib/flatpak/appstream/flathub; do for a in x86_64 aarch64; do for s in 128x128 64x64; do f=\"$b/$a/active/icons/$s/$ID.png\"; if [ -s \"$f\" ]; then base64 -w0 \"$f\"; exit 0; fi; done; done; done"
end

fn apt_icon_script(id: string) -> string is
    return "ID=" + shx::q(id) + "; for f in /var/cache/app-info/icons/*/128x128/$ID.png /var/cache/app-info/icons/*/64x64/$ID.png; do if [ -s \"$f\" ]; then base64 -w0 \"$f\"; exit 0; fi; done"
end

fn png_url(b64: string) -> string is
    return if b64 == "" then "" else "data:image/png;base64," + b64
end

pub fn single_flatpak_icon(id: string) -> string is
    if !safe_id(id) is return "" end
    return png_url(string_trim(shx::run_sh(flatpak_icon_script(id), 5).stdout))
end

pub fn single_apt_icon(id: string) -> string is
    if !safe_id(id) is return "" end
    return png_url(string_trim(shx::run_sh(apt_icon_script(id), 5).stdout))
end

fn snap_json_script(name: string) -> string is
    return "curl -fsS --max-time 4 -H 'Snap-Device-Series: 16' " + shx::q("https://api.snapcraft.io/v2/snaps/info/" + name)
end

fn icon_url_from_snap_json(raw: string) -> string is
    let media: [string] = jx::array_items(jx::get_raw(jx::get_raw(raw, "snap"), "media"))
    let mut i: int = 0
    while i < array_len(media) is
        if jx::get_str(media[i], "type") == "icon" is return jx::get_str(media[i], "url") end
        i += 1
    end
    return ""
end

fn snap_icon_fetch_script(url: string) -> string is
    return "curl -fsSL --max-time 4 " + shx::q(url) + " | head -c 1500001 | base64 -w0"
end

fn mime_for(url: string) -> string is
    return if string_ends_with(url, ".svg") then "image/svg+xml" else "image/png"
end

pub fn snapcraft_icon(name: string) -> string is
    if name == "" is return "" end
    let o: shx::Out = shx::run_sh(snap_json_script(name), 5)
    if o.code != 0 is return "" end
    let u: string = icon_url_from_snap_json(o.stdout)
    if u == "" is return "" end
    let b: string = string_trim(shx::run_sh(snap_icon_fetch_script(u), 6).stdout)
    if b == "" || string_len(b) > 2000000 is return "" end
    return "data:" + mime_for(u) + ";base64," + b
end

;; dedup (source::name lowercase), max 24, dołącz ikony równolegle
fn dedupe_and_enrich(items: [string]) -> [string] is
    let mut seen: [string] = []
    let mut dd: [string] = []
    let mut i: int = 0
    while i < array_len(items) && array_len(dd) < 24 is
        let key: string = jx::get_str(items[i], "source") + "::" + string_lower(jx::get_str(items[i], "name"))
        if !contains(seen, key) is
            seen = array_push(seen, key)
            dd = array_push(dd, items[i])
        end
        i += 1
    end
    ;; etap 1: lokalne ikony + JSON snapcrafta (równolegle)
    let mut scripts: [string] = []
    let mut idx: [int] = []
    i = 0
    while i < array_len(dd) is
        let src: string = jx::get_str(dd[i], "source")
        let pid: string = jx::get_str(dd[i], "package_id")
        if src == "flatpak" && safe_id(pid) is
            scripts = array_push(scripts, flatpak_icon_script(pid))
            idx = array_push(idx, i)
        end
        if src == "apt" && safe_id(pid) is
            scripts = array_push(scripts, apt_icon_script(pid))
            idx = array_push(idx, i)
        end
        if src == "snap" && pid != "" is
            scripts = array_push(scripts, snap_json_script(pid))
            idx = array_push(idx, i)
        end
        i += 1
    end
    if array_len(scripts) == 0 is return dd end
    let p1: shx::ParOut = shx::par(scripts, 6)
    let mut icons: [string] = []
    i = 0
    while i < array_len(dd) is
        icons = array_push(icons, "")
        i += 1
    end
    let mut s2: [string] = []
    let mut idx2: [int] = []
    let mut urls: [string] = []
    let mut k: int = 0
    while k < array_len(idx) is
        let di: int = idx[k]
        let src2: string = jx::get_str(dd[di], "source")
        let o: string = string_trim(p1.outs[k])
        if src2 == "snap" is
            let u: string = if p1.codes[k] == 0 then icon_url_from_snap_json(o) else ""
            if u != "" is
                s2 = array_push(s2, snap_icon_fetch_script(u))
                idx2 = array_push(idx2, di)
                urls = array_push(urls, u)
            end
        else is
            icons[di] = png_url(o)
        end
        k += 1
    end
    if array_len(s2) > 0 is
        let p2: shx::ParOut = shx::par(s2, 6)
        let mut m: int = 0
        while m < array_len(s2) is
            let b: string = string_trim(p2.outs[m])
            if b != "" && string_len(b) <= 2000000 is
                icons[idx2[m]] = "data:" + mime_for(urls[m]) + ";base64," + b
            end
            m += 1
        end
    end
    let mut out: [string] = []
    i = 0
    while i < array_len(dd) is
        out = array_push(out, if icons[i] == "" then dd[i] else jx::set_str(dd[i], "icon", icons[i]))
        i += 1
    end
    return out
end

