fn first_cols(text: string, skip: int) -> [string] is
    let ls: [string] = shx::lines_of(text)
    let mut out: [string] = []
    let mut i: int = skip
    while i < array_len(ls) is
        let c: [string] = ws_split(ls[i])
        i += 1
        if array_len(c) > 0 is out = array_push(out, c[0]) end
    end
    return out
end

