fn locale_val(raw: string) -> string is
    let t: string = string_trim(raw)
    if jwalk::is_strv(t) is return jx::raw_to_str(t) end
    if jwalk::is_obj(t) is
        let c: string = jx::get_raw(t, "C")
        if jwalk::is_strv(c) is return jx::raw_to_str(c) end
        let ks: [string] = jx::keys(t)
        let mut i: int = 0
        while i < array_len(ks) is
            let v: string = jx::get_raw(t, ks[i])
            if jwalk::is_strv(v) is return jx::raw_to_str(v) end
            i += 1
        end
    end
    return ""
end

fn find_locale(obj: string, sub: string) -> string is
    if !jwalk::is_obj(obj) is return "" end
    let ks: [string] = jx::keys(obj)
    let mut i: int = 0
    while i < array_len(ks) is
        if string_contains(string_lower(ks[i]), sub) is
            let s: string = locale_val(jx::get_raw(obj, ks[i]))
            if s != "" is return s end
        end
        i += 1
    end
    i = 0
    while i < array_len(ks) is
        let f: string = find_locale(jx::get_raw(obj, ks[i]), sub)
        if f != "" is return f end
        i += 1
    end
    return ""
end

fn plain_strings(raw: string, acc: [string]) -> [string] is
    let mut out: [string] = acc
    let t: string = string_trim(raw)
    if jwalk::is_strv(t) is return array_push(out, jx::raw_to_str(t)) end
    if jwalk::is_arr(t) is
        let items: [string] = jx::array_items(t)
        let mut i: int = 0
        while i < array_len(items) is
            out = plain_strings(items[i], out)
            i += 1
        end
    end
    return out
end

fn strings_under(obj: string, sub: string, acc: [string]) -> [string] is
    let mut out: [string] = acc
    if !jwalk::is_obj(obj) is return out end
    let ks: [string] = jx::keys(obj)
    let mut i: int = 0
    while i < array_len(ks) is
        let v: string = jx::get_raw(obj, ks[i])
        if string_contains(string_lower(ks[i]), sub) is
            out = plain_strings(v, out)
        else is
            out = strings_under(v, sub, out)
        end
        i += 1
    end
    return out
end

fn urls_under(raw: string, sub: string, acc: [string]) -> [string] is
    let mut out: [string] = acc
    if jwalk::is_obj(raw) is
        let ks: [string] = jx::keys(raw)
        let mut i: int = 0
        while i < array_len(ks) is
            let v: string = jx::get_raw(raw, ks[i])
            if string_contains(string_lower(ks[i]), sub) is
                let all: [string] = jwalk::collect_strings(v)
                let mut j: int = 0
                while j < array_len(all) is
                    if string_starts_with(all[j], "http") is out = array_push(out, all[j]) end
                    j += 1
                end
            else is
                out = urls_under(v, sub, out)
            end
            i += 1
        end
    end
    if jwalk::is_arr(raw) is
        let items: [string] = jx::array_items(raw)
        let mut k: int = 0
        while k < array_len(items) is
            out = urls_under(items[k], sub, out)
            k += 1
        end
    end
    return out
end

fn sort_dedup(xs: [string]) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(xs) is
        let x: string = xs[i]
        i += 1
        if contains(out, x) is continue end
        let mut pos: int = array_len(out)
        let mut j: int = 0
        while j < array_len(out) is
            if x < out[j] is
                pos = j
                break
            end
            j += 1
        end
        let mut n: [string] = []
        let mut k: int = 0
        while k < array_len(out) is
            if k == pos is n = array_push(n, x) end
            n = array_push(n, out[k])
            k += 1
        end
        if pos >= array_len(out) is n = array_push(n, x) end
        out = n
    end
    return out
end

fn strip_simple_markup(s: string) -> string is
    let mut text: string = ""
    let n: int = string_len(s)
    let mut i: int = 0
    while i < n is
        let lt: int = string_find(string_slice(s, i, n), "<")
        if lt < 0 is
            text = text + string_slice(s, i, n)
            break
        end
        text = text + string_slice(s, i, i + lt)
        let rest: string = string_slice(s, i + lt, n)
        let gt: int = string_find(rest, ">")
        if gt < 0 is break end
        text = text + "\n"
        i = i + lt + gt + 1
    end
    let ls: [string] = str_split(text, "\n")
    let mut parts: [string] = []
    let mut j: int = 0
    while j < array_len(ls) is
        let t: string = string_trim(ls[j])
        if t != "" is parts = array_push(parts, t) end
        j += 1
    end
    return iter_join(parts, "\n\n")
end

pub struct Det is
    pub summary:     string
    pub description: string
    pub icon:        string
    pub shots:       [string]
    pub version:     string
    pub license:     string
    pub homepage:    string
    pub cats:        [string]
    pub size:        string
    pub confinement: string
end

fn det_empty() -> Det is
    return Det { summary: "", description: "", icon: "", shots: [], version: "", license: "", homepage: "", cats: [], size: "", confinement: "" }
end

fn enrich_appstream(d: Det, json: string) -> Det is
    let mut r: Det = d
    let root: string = if jwalk::is_arr(json) then (if array_len(jx::array_items(json)) > 0 then jx::array_items(json)[0] else "null") else json
    let s: string = find_locale(root, "summary")
    if s != "" is r.summary = s end
    let de: string = find_locale(root, "description")
    if de != "" is r.description = strip_simple_markup(de) end
    let hp: string = jwalk::find_str(root, "homepage")
    if hp != "" is r.homepage = hp end
    let lic: string = jwalk::find_str(root, "project_license")
    let lic2: string = if lic != "" then lic else jwalk::find_str(root, "license")
    if lic2 != "" is r.license = lic2 end
    let cats: [string] = sort_dedup(strings_under(root, "categor", []))
    if array_len(cats) > 0 is r.cats = cats end
    let raw_shots: [string] = urls_under(root, "screenshot", [])
    let mut keep: [string] = []
    let mut i: int = 0
    while i < array_len(raw_shots) is
        let u: string = raw_shots[i]
        i += 1
        if string_ends_with(u, ".png") || string_ends_with(u, ".jpg") || string_ends_with(u, ".jpeg") || string_contains(u, "screenshot") is
            keep = array_push(keep, u)
        end
    end
    let shots: [string] = sort_dedup(keep)
    if array_len(shots) > 0 is
        let mut top: [string] = []
        let mut j: int = 0
        while j < array_len(shots) && j < 6 is
            top = array_push(top, shots[j])
            j += 1
        end
        r.shots = top
    end
    return r
end

fn parse_snap_info(d: Det, text: string) -> Det is
    let mut r: Det = d
    let ls: [string] = shx::lines_of(text)
    let mut in_desc: bool = false
    let mut desc: [string] = []
    let mut i: int = 0
    while i < array_len(ls) is
        let line: string = ls[i]
        i += 1
        if string_starts_with(line, "summary:") is
            r.summary = string_trim(string_slice(line, 8, string_len(line)))
            continue
        end
        if string_starts_with(line, "license:") is
            r.license = string_trim(string_slice(line, 8, string_len(line)))
            continue
        end
        if string_starts_with(line, "publisher:") is
            r.cats = array_push(r.cats, "Publisher: " + string_trim(string_slice(line, 10, string_len(line))))
            continue
        end
        if string_starts_with(line, "confinement:") is
            r.confinement = string_trim(string_slice(line, 12, string_len(line)))
            continue
        end
        if string_starts_with(line, "description:") is
            in_desc = true
            continue
        end
        if in_desc is
            if string_starts_with(line, " ") || string_starts_with(line, "|") is
                let mut l2: string = line
                while string_starts_with(l2, "|") is l2 = string_slice(l2, 1, string_len(l2)) end
                desc = array_push(desc, string_trim(l2))
            else is
                in_desc = false
            end
        end
        let tl: string = string_trim(line)
        if string_starts_with(tl, "stable:") is
            let parts: [string] = ws_split(string_slice(tl, 7, string_len(tl)))
            if array_len(parts) > 0 is r.version = parts[0] end
            let mut k: int = 0
            while k < array_len(parts) is
                if string_ends_with(parts[k], "MB") || string_ends_with(parts[k], "kB") || string_ends_with(parts[k], "GB") is
                    r.size = parts[k]
                    break
                end
                k += 1
            end
        end
    end
    if array_len(desc) > 0 is r.description = string_trim(iter_join(desc, " ")) end
    return r
end

fn parse_brew_info(d: Det, text: string) -> Det is
    let mut r: Det = d
    let f: [string] = jx::array_items(jx::get_raw(text, "formulae"))
    let c: [string] = jx::array_items(jx::get_raw(text, "casks"))
    let item: string = if array_len(f) > 0 then f[0] else (if array_len(c) > 0 then c[0] else "")
    if item == "" is return r end
    let ds: string = jx::get_str(item, "desc")
    if ds != "" is
        r.summary = ds
        r.description = ds
    end
    let hp: string = jx::get_str(item, "homepage")
    if hp != "" is r.homepage = hp end
    let lic: string = jx::get_str(item, "license")
    if lic != "" is r.license = lic end
    let sv: string = jx::get_str(jx::get_raw(item, "versions"), "stable")
    if sv != "" is r.version = sv end
    return r
end

;; JSON {"average","count"} albo "null"
fn fetch_rating(app_id: string) -> string is
    if app_id == "" is return "null" end
    let o: shx::Out = shx::run_sh("curl -fsS --max-time 3 " + shx::q("https://odrs.gnome.org/api/v2/ratings/" + app_id), 4)
    if o.code != 0 || !jwalk::is_obj(o.stdout) is return "null" end
    let mut weighted: int = 0
    let mut count: int = 0
    let mut s: int = 1
    while s <= 5 is
        let n: int = jx::get_int(o.stdout, "star" + to_string(s))
        weighted += s * n
        count += n
        s += 1
    end
    if count == 0 is return "null" end
    let r = jx::ob()
    jx::p_raw(r, "average", to_string((weighted + 0.0) / (count + 0.0)))
    jx::p_int(r, "count", count)
    return jx::ob_end(r)
end

fn file_icon_b64(path: string) -> string is
    if path == "" || !fs::exists(path) is return "" end
    let b: shx::Out = shx::run(["base64", "-w0", path])
    if b.code != 0 || string_trim(b.stdout) == "" is return "" end
    return "data:image/png;base64," + string_trim(b.stdout)
end

fn details_json(pid: string, name: string, source: string, d: Det, rating: string, local_rating: string) -> string is
    let o = jx::ob()
    jx::p_str(o, "id", pid)
    jx::p_str(o, "name", name)
    jx::p_str(o, "source", source)
    jx::p_str(o, "package_id", pid)
    jx::p_str(o, "summary", d.summary)
    jx::p_str(o, "description", d.description)
    jx::p_opt(o, "icon", d.icon, d.icon != "")
    jx::p_strs(o, "screenshots", d.shots)
    jx::p_opt(o, "version", d.version, d.version != "")
    jx::p_opt(o, "license", d.license, d.license != "")
    jx::p_opt(o, "homepage", d.homepage, d.homepage != "")
    jx::p_strs(o, "categories", d.cats)
    jx::p_opt(o, "size", d.size, d.size != "")
    jx::p_raw(o, "rating", rating)
    jx::p_raw(o, "local_rating", local_rating)
    jx::p_opt(o, "confinement", d.confinement, d.confinement != "")
    return jx::ob_end(o)
end

pub fn cmd_get_app_details(args: string) -> shx::Res is
    let pid_raw: string = jx::get_str(args, "packageId")
    let source: string = jx::get_str(args, "source")
    let nm: string = jx::get_str(args, "name")
    let name: string = if nm != "" then nm else pid_raw
    let mut d: Det = det_empty()
    let v: shx::Res = security::validate_pkg_token(pid_raw)
    if !v.ok is
        d.summary = v.err
        d.description = v.err
        return shx::ok(details_json(pid_raw, name, source, d, "null", "null"))
    end
    let pid: string = v.val
    if source == "flatpak" is
        let info: string = curated::flatpak_remote_info(pid)
        d.version = jx::get_str(info, "version")
        d.size = jx::get_str(info, "size")
        d.icon = single_flatpak_icon(pid)
        if ensure_appstream().ok is
            let j: string = appstream_get(pid)
            if j != "" is d = enrich_appstream(d, j) end
        end
    end
    if source == "apt" is
        let info: string = pkgbackend::show_info(pid)
        d.version = jx::get_str(info, "version")
        d.size = jx::get_str(info, "size")
        d.icon = single_apt_icon(pid)
        if ensure_appstream().ok is
            let j1: string = appstream_get(pid)
            let j: string = if j1 != "" then j1 else appstream_get(pid + ".desktop")
            if j != "" is d = enrich_appstream(d, j) end
        end
        if d.summary == "" is
            let ds: string = string_trim(jx::get_str(info, "description"))
            if ds != "" is
                d.summary = ds
                d.description = ds
            end
        end
    end
    if source == "snap" is
        let o: shx::Out = shx::run_timeout(["snap", "info", pid], 6)
        if o.spawned && !o.timed_out is d = parse_snap_info(d, o.stdout) end
        d.icon = snapcraft_icon(pid)
    end
    if source == "brew" is
        let o2: shx::Out = shx::run_timeout(["brew", "info", "--json=v2", pid], 6)
        if o2.spawned && !o2.timed_out && jwalk::is_obj(o2.stdout) is d = parse_brew_info(d, o2.stdout) end
    end
    if source == "hpm" is
        let info: string = hpm::info(pid)
        if info != "" is
            d.version = jx::get_str(info, "version")
            d.summary = jx::get_str(info, "summary")
            d.description = jx::get_str(info, "description")
            d.license = jx::get_str(info, "license")
            d.cats = jx::get_strs(info, "tags")
        end
    end
    if source == "nix" is
        let info: string = hnm::info(pid)
        if info != "" is
            d.version = jx::get_str(info, "version")
            d.summary = jx::get_str(info, "summary")
            d.description = jx::get_str(info, "description")
            d.homepage = jx::get_str(info, "homepage")
            d.license = jx::get_str(info, "license")
        end
    end
    if source == "appimage" is
        let entry: string = appimage::feed_entry(pid)
        if entry != "" is
            let de: string = jx::get_str(entry, "description")
            d.summary = hpm::take_chars(de, 140)
            d.description = de
            d.homepage = jx::get_str(entry, "homepage")
            d.cats = jx::get_strs(entry, "categories")
        end
        if d.homepage == "" is d.homepage = "https://github.com/" + pid end
        let inst: string = appimage::is_installed(pid)
        if inst != "" is
            d.version = jx::get_str(inst, "version")
            d.icon = file_icon_b64(jx::get_str(inst, "icon_path"))
        end
    end
    if d.summary == "" && d.description != "" is d.summary = hpm::take_chars(d.description, 140) end
    if d.description == "" && d.summary != "" is d.description = d.summary end
    let mut rating: string = "null"
    if settings::current().ratings_enabled && source == "flatpak" is rating = fetch_rating(pid) end
    return shx::ok(details_json(pid, name, source, d, rating, ratings::local_rating_json(source, pid)))
end
