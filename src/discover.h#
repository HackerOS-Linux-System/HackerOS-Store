const TTL: int = 120

fn mk_issue(source: string, kind: string, message: string) -> string is
    let o = jx::ob()
    jx::p_str(o, "source", source)
    jx::p_str(o, "kind", kind)
    jx::p_str(o, "message", message)
    return jx::ob_end(o)
end

fn issue_res(source: string, kind: string, message: string) -> shx::Res is
    return shx::fail(mk_issue(source, kind, message))
end

;; Res: ok => stdout; !ok => err = JSON SourceIssue (odpowiednik run_timeout_reported)
fn reported(argv: [string], secs: int, source: string) -> shx::Res is
    let o: shx::Out = shx::run_timeout(argv, secs)
    if o.timed_out is
        return issue_res(source, "timeout", source + " did not respond within " + to_string(secs) + "s.")
    end
    if !o.spawned is
        return issue_res(source, "unavailable", source + " is not installed on this system.")
    end
    return shx::ok(o.stdout)
end

fn dres(name: string, version: string, desc: string, source: string, pid: string) -> string is
    let o = jx::ob()
    jx::p_str(o, "name", name)
    jx::p_str(o, "version", version)
    jx::p_str(o, "desc", desc)
    jx::p_str(o, "source", source)
    jx::p_str(o, "package_id", pid)
    jx::p_null(o, "size")
    jx::p_null(o, "icon")
    return jx::ob_end(o)
end

fn ws_split(s: string) -> [string] is
    let mut out: [string] = []
    let n: int = string_len(s)
    let mut i: int = 0
    let mut start: int = -1
    while i < n is
        let b: int = byte_at(s, i)
        let sp: bool = b == 32 || b == 9 || b == 13
        if sp is
            if start >= 0 is
                out = array_push(out, string_slice(s, start, i))
                start = -1
            end
        else is
            if start < 0 is start = i end
        end
        i += 1
    end
    if start >= 0 is out = array_push(out, string_slice(s, start, n)) end
    return out
end

;; ───────── źródła ─────────
fn search_flatpak(query: string) -> shx::Res is
    let r: shx::Res = reported(["flatpak", "search", "--columns=name,description,application,version", query], 5, "flatpak")
    if !r.ok is return r end
    let lines: [string] = shx::lines_of(r.val)
    let mut out: [string] = []
    let mut taken: int = 0
    let mut i: int = 0
    while i < array_len(lines) && taken < 10 is
        let l: string = lines[i]
        i += 1
        if string_starts_with(l, "Name") is continue end
        taken += 1
        let c: [string] = str_split(l, "\t")
        if array_len(c) < 3 is continue end
        let name: string = string_trim(c[0])
        if name == "" is continue end
        let ver: string = if array_len(c) > 3 then string_trim(c[3]) else ""
        out = array_push(out, dres(name, ver, string_trim(c[1]), "flatpak", string_trim(c[2])))
    end
    return shx::ok(jx::arr_raw(out))
end

fn search_snap(query: string) -> shx::Res is
    let r: shx::Res = reported(["snap", "find", query], 6, "snap")
    if !r.ok is return r end
    let lines: [string] = shx::lines_of(r.val)
    let mut out: [string] = []
    let mut i: int = 1
    while i < array_len(lines) && i < 9 is
        let c: [string] = ws_split(lines[i])
        i += 1
        if array_len(c) == 0 is continue end
        let ver: string = if array_len(c) > 1 then c[1] else ""
        let mut desc: string = ""
        let mut j: int = 3
        while j < array_len(c) is
            desc = if desc == "" then c[j] else desc + " " + c[j]
            j += 1
        end
        out = array_push(out, dres(c[0], ver, desc, "snap", c[0]))
    end
    return shx::ok(jx::arr_raw(out))
end

fn search_brew(query: string) -> shx::Res is
    let r: shx::Res = reported(["brew", "search", query], 6, "brew")
    if !r.ok is return r end
    let lines: [string] = shx::lines_of(r.val)
    let mut out: [string] = []
    let mut in_sec: bool = false
    let mut i: int = 0
    while i < array_len(lines) && i < 40 is
        let l: string = lines[i]
        i += 1
        if string_starts_with(l, "=") is
            in_sec = true
            continue
        end
        if !in_sec is continue end
        let name: string = string_trim(l)
        if name == "" is continue end
        out = array_push(out, dres(name, "", "", "brew", name))
        if array_len(out) >= 8 is break end
    end
    return shx::ok(jx::arr_raw(out))
end

pub fn fetch_source(source: string, query: string) -> shx::Res is
    if source == "apt" is return pkgbackend::search(query) end
    if source == "flatpak" is return search_flatpak(query) end
    if source == "snap" is return search_snap(query) end
    if source == "brew" is return search_brew(query) end
    if source == "hpm" is return hpm::search(query) end
    if source == "nix" is return hnm::search(query) end
    if source == "appimage" is return appimage::search(query) end
    return shx::ok("[]")
end

;; tryb `--src SOURCE QUERY`: JSON {"ok":true,"val":[..]} / {"ok":false,"err":"<issue json>"}
pub fn src_json(source: string, query: string) -> string is
    let r: shx::Res = fetch_source(source, query)
    let o = jx::ob()
    jx::p_bool(o, "ok", r.ok)
    if r.ok is jx::p_raw(o, "val", if string_trim(r.val) == "" then "[]" else r.val) end
    if !r.ok is jx::p_str(o, "err", r.err) end
    return jx::ob_end(o)
end

fn self_exe() -> string is
    let r: string = string_trim(proc::run("readlink -f /proc/" + to_string(getpid()) + "/exe"))
    return if r == "" then env::args()[0] else r
end

pub struct Batch is
    pub results: [string]
    pub issues:  [string]
end

fn all_sources() -> [string] is
    return ["apt", "flatpak", "snap", "brew", "hpm", "nix", "appimage"]
end

fn contains(xs: [string], v: string) -> bool is
    let mut i: int = 0
    while i < array_len(xs) is
        if xs[i] == v is return true end
        i += 1
    end
    return false
end

;; Dla każdego zapytania zwraca Batch (wyniki + problemy), źródła odpytywane równolegle, wyniki cache'owane per źródło.
fn run_all_sources(queries: [string], enabled: [string]) -> [Batch] is
    let srcs: [string] = all_sources()
    let mut keys: [string] = []
    let mut cached: [string] = []
    let mut scripts: [string] = []
    let mut task_of: [int] = []
    let mut t: int = 0
    let exe: string = self_exe()
    let inline: bool = env::get("HOS_INLINE") == "1"
    let mut qi: int = 0
    while qi < array_len(queries) is
        let q: string = queries[qi]
        let qlc: string = string_lower(q)
        let mut si: int = 0
        while si < array_len(srcs) is
            let s: string = srcs[si]
            si += 1
            if !contains(enabled, s) is
                keys = array_push(keys, "")
                cached = array_push(cached, "")
                task_of = array_push(task_of, -1)
                continue
            end
            let key: string = s + ":" + qlc
            keys = array_push(keys, key)
            let c: string = cache::get(key, TTL)
            cached = array_push(cached, c)
            if c == "" is
                task_of = array_push(task_of, t)
                t += 1
                scripts = array_push(scripts, shx::q(exe) + " --src " + shx::q(s) + " " + shx::q(q))
            else is
                task_of = array_push(task_of, -1)
            end
        end
        qi += 1
    end
    let mut outs: [string] = []
    if t > 0 is
        if inline is
            let mut k: int = 0
            qi = 0
            while qi < array_len(queries) is
                let mut si2: int = 0
                while si2 < array_len(srcs) is
                    let idx: int = qi * array_len(srcs) + si2
                    si2 += 1
                    if task_of[idx] >= 0 is outs = array_push(outs, src_json(srcs[si2 - 1], queries[qi])) end
                end
                qi += 1
            end
        else is
            outs = shx::par(scripts, 17).outs
        end
    end
    let mut batches: [Batch] = []
    qi = 0
    while qi < array_len(queries) is
        let mut res: [string] = []
        let mut iss: [string] = []
        let mut si3: int = 0
        while si3 < array_len(srcs) is
            let idx2: int = qi * array_len(srcs) + si3
            let s2: string = srcs[si3]
            si3 += 1
            if keys[idx2] == "" is continue end
            let mut outcome: string = cached[idx2]
            if outcome == "" is
                let o: string = string_trim(outs[task_of[idx2]])
                if o == "" || !string_starts_with(o, "{") is
                    iss = array_push(iss, mk_issue(s2, "timeout", s2 + " did not respond in time."))
                    continue
                end
                outcome = o
                cache::set(keys[idx2], o)
            end
            if jx::get_bool(outcome, "ok") is
                res = array_concat(res, jx::array_items(jx::get_raw(outcome, "val")))
            else is
                let e: string = jx::get_str(outcome, "err")
                if e != "" is iss = array_push(iss, e) end
            end
        end
        batches = array_push(batches, Batch { results: res, issues: iss })
        qi += 1
    end
    return batches
end

