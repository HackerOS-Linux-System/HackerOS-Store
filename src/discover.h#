fn cat_kws(id: string) -> [string] is
    if id == "development" is return ["ide", "compiler git"] end
    if id == "office" is return ["office suite", "pdf reader"] end
    if id == "graphics" is return ["image editor", "photo editor"] end
    if id == "media" is return ["video editor", "audio editor"] end
    if id == "internet" is return ["web browser", "email client"] end
    if id == "security" is return ["password manager", "vpn client"] end
