pub fn cmd_discover_categories(args: string) -> shx::Res is
    let ids: [string] = cat_ids()
    let lb: [string] = cat_labels()
    let ic: [string] = cat_icons()
    let mut items: [string] = []
    let mut i: int = 0
    while i < array_len(ids) is
        let o = jx::ob()
        jx::p_str(o, "id", ids[i])
        jx::p_str(o, "label", lb[i])
        jx::p_str(o, "icon", ic[i])
        items = array_push(items, jx::ob_end(o))
        i += 1
    end
    return shx::ok(jx::arr_raw(items))
end

fn response(results: [string], issues: [string]) -> string is
    let o = jx::ob()
    jx::p_raw(o, "results", jx::arr_raw(results))
    jx::p_raw(o, "issues", jx::arr_raw(issues))
    return jx::ob_end(o)
end

pub fn cmd_discover_browse(args: string) -> shx::Res is
    let cat: string = jx::get_str(args, "categoryId")
    let st: settings::Settings = settings::current()
    let key: string = "browse:" + cat + ":" + iter_join(st.enabled_sources, ",")
    let c: string = cache::get(key, TTL)
    if c != "" is return shx::ok(c) end
    let kws: [string] = cat_kws(cat)
    let mut all: [string] = []
    let mut issues: [string] = []
    if array_len(kws) > 0 is
        let bs: [Batch] = run_all_sources(kws, st.enabled_sources)
        let mut b: int = 0
        while b < array_len(bs) is
            all = array_concat(all, bs[b].results)
            let mut j: int = 0
            while j < array_len(bs[b].issues) is
                let src: string = jx::get_str(bs[b].issues[j], "source")
                let mut dup: bool = false
                let mut q: int = 0
                while q < array_len(issues) is
                    if jx::get_str(issues[q], "source") == src is dup = true end
                    q += 1
                end
                if !dup is issues = array_push(issues, bs[b].issues[j]) end
                j += 1
            end
            b += 1
        end
    end
    let out: string = response(dedupe_and_enrich(all), issues)
    cache::set(key, out)
    return shx::ok(out)
end

pub fn cmd_discover_search(args: string) -> shx::Res is
    let query: string = jx::get_str(args, "query")
    let st: settings::Settings = settings::current()
    let key: string = "search:" + string_lower(query) + ":" + iter_join(st.enabled_sources, ",")
    let c: string = cache::get(key, TTL)
    if c != "" is return shx::ok(c) end
    let bs: [Batch] = run_all_sources([query], st.enabled_sources)
    let out: string = response(dedupe_and_enrich(bs[0].results), bs[0].issues)
    cache::set(key, out)
    return shx::ok(out)
end

;; ───────── install / uninstall ─────────
fn snap_install(id_in: string, channel: string) -> shx::Res is
    let v: shx::Res = security::validate_pkg_token(id_in)
    if !v.ok is return v end
    let id: string = v.val
    let info: shx::Out = shx::run_timeout(["snap", "info", id], 5)
    let mut conf: string = ""
    if info.spawned && !info.timed_out is
        let ls: [string] = shx::lines_of(info.stdout)
        let mut i: int = 0
        while i < array_len(ls) is
            if string_starts_with(ls[i], "confinement:") is
                conf = string_trim(string_slice(ls[i], 12, string_len(ls[i])))
                break
            end
            i += 1
        end
    end
    let mut args: [string] = ["install", id]
    if conf == "classic" is
        shx::emit_log("info", id + " requires classic confinement — installing with --classic.")
        args = array_push(args, "--classic")
    end
    if conf == "devmode" is
        shx::emit_log("info", id + " is only published in devmode (development snap).")
        args = array_push(args, "--devmode")
    end
    let chan: string = if channel != "" then channel else settings::current().snap_default_channel
    if chan != "" && string_lower(chan) != "stable" is
        let cv: shx::Res = security::validate_pkg_token(chan)
        if !cv.ok is return cv end
        shx::emit_log("info", "Installing " + id + " from channel " + cv.val + "...")
        args = array_push(args, "--channel=" + cv.val)
    end
    return shx::priv_run(array_concat(["snap"], args))
end

fn last_segment(s: string) -> string is
    let i: int = string_rfind(s, "/")
    return if i < 0 then s else string_slice(s, i + 1, string_len(s))
end

fn emsg(r: shx::Res) -> string is
    return if r.ok then "" else r.err
end

pub fn cmd_discover_install(args: string) -> shx::Res is
    let pv: shx::Res = security::validate_pkg_token(jx::get_str(args, "packageId"))
    if !pv.ok is return pv end
    let pid: string = pv.val
    let source: string = jx::get_str(args, "source")
    let nm: string = jx::get_str(args, "name")
    let display: string = if nm != "" then nm else last_segment(pid)
    shx::emit_log("info", "Installing " + pid + " via " + source + "...")
    shx::emit_prog("install", "Installing " + pid + "...", 0.2)
    let mut result: shx::Res = shx::fail("Unknown source: " + source)
    if source == "apt" is result = curated::apt_install([pid]) end
    if source == "flatpak" is
        result = curated::ensure_flatpak()
        if result.ok is
            let st: settings::Settings = settings::current()
            let r0: string = jx::get_str(args, "remote")
            let rn: shx::Res = security::validate_pkg_token(if r0 != "" then r0 else st.flatpak_default_remote)
            if !rn.ok is
                result = rn
            else is
                let b0: string = jx::get_str(args, "branch")
                let ref_arg: string = curated::flatpak_ref(pid, if b0 != "" then b0 else st.flatpak_default_branch)
                let t1: shx::Res = shx::run_streaming(["flatpak", "install", "-y", "--user", rn.val, ref_arg])
                result = if t1.ok then t1 else shx::priv_run(["flatpak", "install", "-y", rn.val, ref_arg])
            end
        end
    end
    if source == "snap" is result = snap_install(pid, jx::get_str(args, "channel")) end
    if source == "brew" is result = shx::run_streaming(["brew", "install", pid]) end
    if source == "hpm" is result = hpm::install(pid) end
    if source == "nix" is result = hnm::install(pid) end
    if source == "appimage" is result = appimage::install(pid, display) end
    let mut version: string = ""
    let mut commit: string = ""
    let mut gen: int = -1
    if result.ok is
        if source == "apt" is version = history::current_apt_version(pid) end
        if source == "appimage" is version = jx::get_str(appimage::is_installed(pid), "version") end
        if source == "flatpak" is commit = curated::flatpak_current_commit(pid) end
        if source == "nix" is gen = hnm::current_generation() end
    end
    if commit != "" is
        history::record_with_commit("install", source, display, pid, version, commit, result.ok, emsg(result))
    else is
        if gen >= 0 is
            history::record_with_generation("install", source, display, pid, version, gen, result.ok, emsg(result))
        else is
            history::record("install", source, display, pid, version, result.ok, emsg(result))
        end
    end
    if !result.ok is return result end
    shx::emit_prog("done", "Done!", 1.0)
    shx::emit_log("success", pid + " installed.")
    return shx::ok(jx::quote(pid + " installed."))
end

pub fn cmd_discover_uninstall(args: string) -> shx::Res is
    let pv: shx::Res = security::validate_pkg_token(jx::get_str(args, "packageId"))
    if !pv.ok is return pv end
    let pid: string = pv.val
    let source: string = jx::get_str(args, "source")
    shx::emit_log("info", "Removing " + pid + " (" + source + ")...")
    shx::emit_prog("uninstall", "Removing " + pid + "...", 0.2)
    let mut result: shx::Res = shx::fail("Unknown source: " + source)
    if source == "apt" is result = curated::apt_remove([pid]) end
    if source == "flatpak" is
        let t1: shx::Res = shx::run_streaming(["flatpak", "uninstall", "-y", "--user", pid])
        result = if t1.ok then t1 else shx::priv_run(["flatpak", "uninstall", "-y", pid])
    end
    if source == "snap" is result = shx::priv_run(["snap", "remove", pid]) end
    if source == "brew" is result = shx::run_streaming(["brew", "uninstall", pid]) end
    if source == "hpm" is result = hpm::remove(pid) end
    if source == "nix" is result = hnm::remove(pid) end
    if source == "appimage" is result = appimage::uninstall(pid) end
    let gen: int = if result.ok && source == "nix" then hnm::current_generation() else -1
    if gen >= 0 is
        history::record_with_generation("uninstall", source, pid, pid, "", gen, result.ok, emsg(result))
    else is
        history::record("uninstall", source, pid, pid, "", result.ok, emsg(result))
    end
    if !result.ok is return result end
    shx::emit_prog("done", "Removed.", 1.0)
    shx::emit_log("success", pid + " removed.")
    return shx::ok(jx::quote(pid + " removed."))
end

