;; let o = jx::ob()
;; jx::p_str(o, "name", "x") ; jx::p_int(o, "n", 3) ; jx::p_bool(o, "ok", true) ; jx::p_raw(o, "list", "[1,2]")
;; let json = jx::ob_end(o)
pub fn ob() -> any is
    let b = sb_new()
    sb_push(b, "{")
    return b
end

pub fn p_raw(b: any, key: string, raw: string) is
    if sb_len(b) > 1 is sb_push(b, ",") end
    sb_push(b, quote(key))
    sb_push(b, ":")
    sb_push(b, raw)
end

pub fn p_str(b: any, key: string, val: string) is
    p_raw(b, key, quote(val))
end

pub fn p_int(b: any, key: string, val: int) is
    p_raw(b, key, to_string(val))
end

pub fn p_bool(b: any, key: string, val: bool) is
    p_raw(b, key, if val then "true" else "false")
end

pub fn p_null(b: any, key: string) is
    p_raw(b, key, "null")
end

;; Option<String>: present=false -> null
pub fn p_opt(b: any, key: string, val: string, present: bool) is
    if present is p_raw(b, key, quote(val)) else is p_raw(b, key, "null") end
end

pub fn p_strs(b: any, key: string, vals: [string]) is
    p_raw(b, key, str_array(vals))
end

pub fn ob_end(b: any) -> string is
    sb_push(b, "}")
    return sb_build(b)
end

;; Tablica z surowych elementów JSON: arr_raw(["{...}", "{...}"]) -> "[{...},{...}]"
pub fn arr_raw(items: [string]) -> string is
    let b = sb_new()
    sb_push(b, "[")
    let mut i: int = 0
    while i < array_len(items) is
        if i > 0 is sb_push(b, ",") end
        sb_push(b, items[i])
        i += 1
    end
    sb_push(b, "]")
    return sb_build(b)
end

;; Surowa wartość -> Option<String> w sensie Rusta: null / brak -> false
pub fn raw_is_null(raw: string) -> bool is
    let t: string = string_trim(raw)
    return t == "" || t == "null"
end

;; Tablica napisów z surowej tablicy JSON
pub fn get_strs(obj: string, key: string) -> [string] is
    let items: [string] = array_items(get_raw(obj, key))
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(items) is
        out = array_push(out, raw_to_str(items[i]))
        i += 1
    end
    return out
end

;; Wartość z "domyślną": gdy klucza brak lub null -> dflt
pub fn get_str_or(obj: string, key: string, dflt: string) -> string is
    let r: string = get_raw(obj, key)
    if raw_is_null(r) is return dflt end
    return raw_to_str(r)
end

pub fn get_bool_or(obj: string, key: string, dflt: bool) -> bool is
    let r: string = get_raw(obj, key)
    if raw_is_null(r) is return dflt end
    return raw_to_str(r) == "true"
end
