;; ───────── Flatpak ─────────
pub fn ensure_flatpak() -> shx::Res is
    if !shx::has("flatpak") is
        shx::emit_log("info", "Installing Flatpak...")
        let r: shx::Res = apt_install(["flatpak"])
        if !r.ok is return r end
    end
    let remotes: [settings::FlatpakRemote] = settings::current().flatpak_remotes
    let mut i: int = 0
    while i < array_len(remotes) is
        let v: shx::Res = security::validate_pkg_token(remotes[i].name)
        i += 1
        if !v.ok is continue end
        let name: string = v.val
        shx::run_streaming(["flatpak", "remote-add", "--if-not-exists", "--user", name, remotes[i - 1].url])
        shx::priv_run(["flatpak", "remote-add", "--if-not-exists", name, remotes[i - 1].url])
    end
    return shx::ok_unit()
end

pub fn flatpak_ref(id: string, branch: string) -> string is
    if branch == "" || string_lower(branch) == "stable" is return id end
    return id + "//" + branch
end

pub fn flatpak_install(id_in: string) -> shx::Res is
    let v: shx::Res = security::validate_pkg_token(id_in)
    if !v.ok is return v end
    let id: string = v.val
    let e: shx::Res = ensure_flatpak()
    if !e.ok is return e end
    let c: shx::Res = shx::check_cancel()
    if !c.ok is return c end
    let st: settings::Settings = settings::current()
    let rvld: shx::Res = security::validate_pkg_token(st.flatpak_default_remote)
    let remote: string = if rvld.ok then rvld.val else "flathub"
    let ref_arg: string = flatpak_ref(id, st.flatpak_default_branch)
    shx::emit_log("info", "Installing " + id + " from " + remote + "...")
    shx::emit_prog("install", "Installing " + id + "...", 0.3)
    let r: shx::Res = shx::run_streaming(["flatpak", "install", "-y", "--user", remote, ref_arg])
    if !r.ok is
        let c2: shx::Res = shx::check_cancel()
        if !c2.ok is return c2 end
        let p: shx::Res = shx::priv_run(["flatpak", "install", "-y", remote, ref_arg])
        if !p.ok is return p end
    end
    shx::emit_prog("done", "Done!", 1.0)
    shx::emit_log("success", "Installation complete.")
    return shx::ok_unit()
end

pub fn flatpak_uninstall(id_in: string) -> shx::Res is
    let v: shx::Res = security::validate_pkg_token(id_in)
    if !v.ok is return v end
    let id: string = v.val
    shx::emit_log("info", "Removing " + id + "...")
    shx::emit_prog("uninstall", "Removing " + id + "...", 0.3)
    let r: shx::Res = shx::run_streaming(["flatpak", "uninstall", "-y", "--user", id])
    if !r.ok is
        let c: shx::Res = shx::check_cancel()
        if !c.ok is return c end
        let p: shx::Res = shx::priv_run(["flatpak", "uninstall", "-y", id])
        if !p.ok is return p end
    end
    shx::emit_prog("done", "Removed.", 1.0)
    shx::emit_log("success", "Removed successfully.")
    return shx::ok_unit()
end

fn colon_rest(line: string) -> string is
    ;; line.split(':').nth(1) — tekst między 1. a 2. dwukropkiem, przycięty
    let parts: [string] = str_split(line, ":")
    if array_len(parts) < 2 is return "" end
    return string_trim(parts[1])
end

;; JSON {"size": str|null, "version": str|null}
pub fn flatpak_remote_info(id: string) -> string is
    let mut version: string = ""
    let mut size: string = ""
    if id != "" is
        let vr: shx::Res = security::validate_pkg_token(settings::current().flatpak_default_remote)
        let remote: string = if vr.ok then vr.val else "flathub"
        let o: shx::Out = shx::run_timeout(["flatpak", "remote-info", "--user", remote, id], 6)
        if o.spawned && !o.timed_out is
            let lines: [string] = shx::lines_of(o.stdout)
            let mut i: int = 0
            while i < array_len(lines) is
                let l: string = lines[i]
                i += 1
                if string_contains(l, "Version:") is version = colon_rest(l) end
                if string_contains(l, "Download Size:") || string_contains(l, "Installed Size:") is size = colon_rest(l) end
            end
        end
    end
    let r = jx::ob()
    jx::p_opt(r, "size", size, id != "" && size != "" || (id != "" && false))
    jx::p_opt(r, "version", version, id != "" && version != "" || (id != "" && false))
    return jx::ob_end(r)
end

;; "" = None
pub fn flatpak_current_commit(id: string) -> string is
    let scopes: [[string]] = [["info", "--user", id], ["info", id]]
    let mut s: int = 0
    while s < 2 is
        let o: shx::Out = shx::run_timeout(array_concat(["flatpak"], scopes[s]), 5)
        s += 1
        if o.spawned && !o.timed_out is
            let lines: [string] = shx::lines_of(o.stdout)
            let mut i: int = 0
            while i < array_len(lines) is
                let t: string = string_trim(lines[i])
                i += 1
                if string_starts_with(t, "Commit:") is
                    let c: string = string_trim(string_slice(t, 7, string_len(t)))
                    if c != "" is return c end
                end
            end
        end
    end
    return ""
end

pub fn flatpak_rollback_to_commit(id_in: string, commit_in: string) -> shx::Res is
    let v: shx::Res = security::validate_pkg_token(id_in)
    if !v.ok is return v end
    let v2: shx::Res = security::validate_pkg_token(commit_in)
    if !v2.ok is return v2 end
    let id: string = v.val
    let commit: string = v2.val
    let arg: string = "--commit=" + commit
    shx::emit_log("info", "Pinning " + id + " to commit " + utf8_head(commit, 12) + "...")
    let r: shx::Res = shx::run_streaming(["flatpak", "update", "-y", "--user", arg, id])
    if !r.ok is
        let p: shx::Res = shx::priv_run(["flatpak", "update", "-y", arg, id])
        if !p.ok is return p end
    end
    return shx::ok_unit()
end

;; ───────── Wine ─────────
pub fn ensure_wine() -> shx::Res is
    if !shx::has("wine") is
        shx::emit_log("info", "Wine not found — installing...")
        let a: shx::Res = pkgbackend::add_foreign_arch("i386")
        if !a.ok is return a end
        let u: shx::Res = pkgbackend::update_index()
        if !u.ok is return u end
        return apt_install(["wine", "wine32", "wine64", "winetricks", "libgl1"])
    end
    if pkgbackend::installed_version("wine32") == "" is
        shx::emit_log("info", "wine32 not found — installing...")
        let a2: shx::Res = pkgbackend::add_foreign_arch("i386")
        if !a2.ok is return a2 end
        let u2: shx::Res = pkgbackend::update_index()
        if !u2.ok is return u2 end
        let i: shx::Res = apt_install(["wine32", "libgl1"])
        if !i.ok is
            return shx::fail("Failed to install wine32. Please run manually:\n  sudo dpkg --add-architecture i386\n  sudo apt-get update\n  sudo apt-get install wine32\n(or, on a hammer-based system: sudo hammer dpkg-arch add i386 && sudo hammer sync && sudo hammer install wine32)")
        end
    end
    return shx::ok_unit()
end

pub fn verify_download(id: string, path: string) -> shx::Res is
    let o: shx::Out = shx::run(["sha256sum", path])
    if !o.spawned is return shx::fail("sha256sum failed: not found") end
    let digest: string = first_word(o.stdout)
    if digest == "" is
        shx::emit_log("stderr", "Could not compute a checksum for the downloaded installer.")
        return shx::ok_unit()
    end
    shx::emit_log("info", "Downloaded installer SHA-256: " + digest)
    shx::emit_log("stderr", "No pinned checksum is configured for this installer (the vendor does not publish stable hashes). Proceeding, but you may want to verify this binary yourself before trusting it.")
    return shx::ok_unit()
end

