fn codename() -> string is
    let o: shx::Out = shx::run(["lsb_release", "-sc"])
    let t: string = string_trim(o.stdout)
    return if o.spawned && o.code == 0 && t != "" then t else "trixie"
end

pub fn ensure_nonfree() -> shx::Res is
    if pkgbackend::backend() == "apt" is return ensure_nonfree_apt() end
    return ensure_nonfree_hammer()
end

fn ensure_nonfree_apt() -> shx::Res is
    let g: shx::Out = shx::run_sh("grep -r non-free /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null | grep -v '#' | grep -q non-free && echo yes", 0)
    if string_trim(g.stdout) == "yes" is return shx::ok_unit() end
    let cn: string = codename()
    let mirror: string = settings::current().apt_mirror
    let host: string = if string_trim(mirror) == "" then "deb.debian.org" else mirror
    let line: string = "deb http://" + host + "/debian " + cn + " main contrib non-free non-free-firmware\n"
    shx::emit_log("info", "Adding non-free repositories for '" + cn + "'...")
    let tmp: string = env::temp_dir() + "/hackeros-nonfree-" + to_string(getpid()) + ".list"
    if !shx::write_file(tmp, line) is return shx::fail("Failed writing temp sources file: " + tmp) end
    let r: shx::Res = shx::priv_run(["install", "-m", "0644", tmp, "/etc/apt/sources.list.d/hackeros-nonfree.list"])
    fs::remove(tmp)
    if !r.ok is return r end
    return shx::priv_run(["apt-get", "update", "-qq"])
end

fn ensure_nonfree_hammer() -> shx::Res is
    if pkgbackend::hammer_mode() == "oci" is
        shx::emit_log("info", "hammer oci mode: non-free components come from the base image's own build-time sources, not something the Store can add live — skipping.")
        return shx::ok_unit()
    end
    let bin: string = pkgbackend::hammer_bin_pub()
    if bin == "" is return shx::fail("hammer is not installed on this system.") end
    let l: shx::Out = shx::run([bin, "repo", "list"])
    if string_contains(l.stdout, "non-free") is return shx::ok_unit() end
    let cn: string = codename()
    let mirror: string = settings::current().apt_mirror
    let host: string = if string_trim(mirror) == "" then "deb.debian.org" else mirror
    let uri: string = "http://" + host + "/debian"
    shx::emit_log("info", "Adding non-free repositories for '" + cn + "' via hammer...")
    let r: shx::Res = shx::priv_run([bin, "repo", "add", uri, cn, "main", "contrib", "non-free", "non-free-firmware"])
    if !r.ok is return r end
    return pkgbackend::update_index()
end

