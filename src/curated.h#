;; env_prefix dla shx::run_streaming_env: [("K","V"),...] -> "K='V' "
fn envp(pairs: [string]) -> string is
    let mut out: string = ""
    let mut i: int = 0
    while i + 1 < array_len(pairs) is
        out = out + pairs[i] + "=" + shx::q(pairs[i + 1]) + " "
        i += 2
    end
    return out
end

fn first_word(s: string) -> string is
    let t: string = string_trim(s)
    let mut i: int = 0
    while i < string_len(t) && byte_at(t, i) != 32 && byte_at(t, i) != 9 is i += 1 end
    return string_slice(t, 0, i)
end

pub fn utf8_head(s: string, n: int) -> string is
    let mut count: int = 0
    let mut i: int = 0
    let len: int = string_len(s)
    while i < len is
        if (byte_at(s, i) & 192) != 128 is
            if count == n is return string_slice(s, 0, i) end
            count += 1
        end
        i += 1
    end
    return s
end

