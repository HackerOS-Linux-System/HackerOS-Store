fn install_wine_launcher(name: string) -> shx::Res is
    let w: shx::Res = ensure_wine()
    if !w.ok is return w end
    let c: shx::Res = shx::check_cancel()
    if !c.ok is return c end
    let meta: [string] = wine_launcher_meta(name)
    let id: string = meta[0]
    let url: string = meta[1]
    let exe: string = meta[2]
    let home: string = shx::home()
    let dir: string = home + "/.hackeros/launchers/" + id
    let prefix: string = dir + "/prefix"
    shx::mkdir_p(prefix)
    let installer: string = dir + "/installer.exe"
    shx::emit_log("info", "Downloading " + name + " installer...")
    shx::emit_prog("download", "Downloading " + name + "...", 0.1)
    let d: shx::Res = shx::run_streaming(["wget", "-q", "-O", installer, url])
    if !d.ok is return d end
    let c2: shx::Res = shx::check_cancel()
    if !c2.ok is return c2 end
    let v: shx::Res = verify_download(id, installer)
    if !v.ok is return v end
    let env: string = "WINEPREFIX=" + shx::q(prefix) + " WINEARCH=win32 WINEDEBUG=-all "
    shx::emit_log("info", "Initialising Wine prefix (win32)...")
    shx::emit_prog("wine", "Initialising Wine prefix...", 0.40)
    let b: shx::Res = shx::run_streaming_env(["wineboot", "--init"], env)
    if !b.ok is return b end
    let c3: shx::Res = shx::check_cancel()
    if !c3.ok is return c3 end
    shx::emit_log("info", "Running " + name + " installer via Wine...")
    shx::emit_prog("wine", "Installing " + name + "...", 0.65)
    let r: shx::Res = shx::run_streaming_env(["wine", installer, "/S"], env)
    if !r.ok is return r end
    let ddir: string = home + "/.local/share/applications"
    shx::mkdir_p(ddir)
    let exe_path: string = prefix + "/drive_c/Program Files (x86)/" + exe
    let desktop: string = "[Desktop Entry]\nName=" + name + "\nExec=env WINEPREFIX=" + prefix + " WINEARCH=win32 WINEDEBUG=-all wine \"" + exe_path + "\"\nType=Application\nCategories=Game;\n"
    fs::write(ddir + "/" + id + ".desktop", desktop)
    shx::emit_prog("done", "Done!", 1.0)
    return shx::ok_unit()
end

fn uninstall_wine_launcher(name: string) -> shx::Res is
    let meta: [string] = wine_launcher_meta(name)
    let id: string = meta[0]
    let home: string = shx::home()
