pub fn ensure_kali() -> shx::Res is
    if kali_exists() is return shx::ok_unit() end
    shx::emit_log("info", "Creating Kali Linux container (first run ~5 min)...")
    shx::emit_prog("install", "Creating Kali container...", 0.15)
