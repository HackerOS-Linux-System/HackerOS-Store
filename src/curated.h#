end

;; Mapa "bin:yes|no" z batch-probe w kontenerze -> Kv
fn probe_container(container: string, env: string, bins: [string]) -> kv::Kv is
    let script: string = "for t in " + iter_join(bins, " ") + "; do command -v \"$t\" >/dev/null 2>&1 && echo \"$t:yes\" || echo \"$t:no\"; done"
    let o: shx::Out = shx::run_env(env, ["distrobox", "enter", container, "--", "sh", "-c", script], 6)
    let mut keys: [string] = []
    let mut vals: [string] = []
    if o.spawned && !o.timed_out is
        let lines: [string] = shx::lines_of(o.stdout)
        let mut i: int = 0
        while i < array_len(lines) is
            let l: string = lines[i]
            i += 1
            let p: int = string_find(l, ":")
            if p > 0 is
                keys = array_push(keys, string_slice(l, 0, p))
                vals = array_push(vals, string_slice(l, p + 1, string_len(l)))
            end
        end
    end
    return kv::from_pairs(keys, vals)
end

pub fn check_all_installed() -> string is
    let mut items: [string] = []
    ;; Flatpak
    let fo: shx::Out = shx::run(["flatpak", "list", "--columns=application,version"])
    let fl: [string] = shx::lines_of(fo.stdout)
    let mut fk: [string] = []
    let mut fv: [string] = []
    let mut i: int = 0
    while i < array_len(fl) is
        let l: string = fl[i]
        i += 1
        let p: int = string_find(l, "\t")
        let id: string = string_trim(if p >= 0 then string_slice(l, 0, p) else l)
        let ver: string = if p >= 0 then string_trim(string_slice(l, p + 1, string_len(l))) else ""
        if id != "" is
            fk = array_push(fk, id)
            fv = array_push(fv, ver)
        end
    end
    let fp: kv::Kv = kv::from_pairs(fk, fv)
    let fkeys: [string] = ["game_launchers::Steam", "game_launchers::Lutris", "game_launchers::Heroic", "game_launchers::Epic Games Store", "game_launchers::Bottles"]
    let fids: [string] = ["com.valvesoftware.Steam", "net.lutris.Lutris", "com.heroicgameslauncher.hgl", "com.heroicgameslauncher.hgl", "com.usebottles.bottles"]
    i = 0
    while i < array_len(fkeys) is
        items = array_push(items, state_obj(fkeys[i], kv::has(fp, fids[i]), kv::get(fp, fids[i])))
        i += 1
    end
    ;; apt / hammer
    let apt: kv::Kv = pkgbackend::installed_map()
    let names: [string] = pentest_tool_names()
    let mut container_tools: [string] = []
    i = 0
    while i < array_len(names) is
        let n: string = names[i]
        i += 1
        if in_debian(n) is
            let pkg: string = apt_pkg_name(n)
            items = array_push(items, state_obj("pentest_tools::" + n, kv::has(apt, pkg), kv::get(apt, pkg)))
        else
            container_tools = array_push(container_tools, n)
        end
    end
    let mut kali: kv::Kv = kv::empty()
    if kali_exists() is kali = probe_container("kali-pentest", "", container_tools) end
    i = 0
    while i < array_len(container_tools) is
        let n2: string = container_tools[i]
        i += 1
        items = array_push(items, state_obj("pentest_tools::" + n2, kv::get(kali, n2) == "yes", ""))
    end
    let dkeys: [string] = ["drivers::NVIDIA Driver", "drivers::AMD Driver", "drivers::Intel Driver", "drivers::WiFi — Broadcom", "drivers::WiFi — Realtek", "drivers::Firmware (non-free)"]
    let dpkgs: [string] = ["nvidia-driver", "firmware-amd-graphics", "intel-media-va-driver", "broadcom-sta-dkms", "rtl8812au-dkms", "firmware-linux-nonfree"]
    i = 0
    while i < array_len(dkeys) is
        items = array_push(items, state_obj(dkeys[i], kv::has(apt, dpkgs[i]), kv::get(apt, dpkgs[i])))
        i += 1
    end
    ;; Ecosystem
    let md: string = hackeros_ecosystem_marker_dir()
    let en: [string] = eco_names()
    let es: [string] = eco_slugs()
    i = 0
    while i < array_len(en) is
        items = array_push(items, state_obj("hackeros_ecosystem::" + en[i], fs::exists(md + "/" + es[i]), ""))
        i += 1
    end
    ;; Dev tools local
    let dl: [string] = dev_locals()
    let dp: [string] = dev_pkgs()
    i = 0
    while i < array_len(dl) is
        items = array_push(items, state_obj("dev_tools::" + dl[i], kv::has(apt, dp[i]), kv::get(apt, dp[i])))
        i += 1
    end
    ;; Dev tools container
    let mut dev: kv::Kv = kv::empty()
    if devbox_exists() is dev = probe_container("hackeros-devbox", PODMAN_ENV, dev_bins()) end
    let dc: [string] = dev_containers()
    let db: [string] = dev_bins()
    i = 0
    while i < array_len(dc) is
        items = array_push(items, state_obj("dev_tools::" + dc[i], kv::get(dev, db[i]) == "yes", ""))
        i += 1
    end
    return jx::arr_raw(items)
end

;; ───────── get_package_info ─────────
fn note_obj(note: string) -> string is
    let o = jx::ob()
    jx::p_null(o, "size")
    jx::p_null(o, "version")
    jx::p_str(o, "note", note)
    return jx::ob_end(o)
end

pub fn get_package_info(name_in: string, category: string) -> string is
    let v: shx::Res = security::validate_display_name(name_in)
    if !v.ok is return note_obj(v.err) end
    let name: string = v.val
    if category == "game_launchers" is
        let id: string = launcher_flatpak_id(name)
        if id != "" is return flatpak_remote_info(id) end
        return note_obj("Downloaded via Wine — size known only after install.")
    end
    if category == "pentest_tools" is
        if in_debian(name) is
            let pv: shx::Res = security::validate_pkg_token(apt_pkg_name(name))
            if !pv.ok is return note_obj(pv.err) end
            return pkgbackend::show_info(pv.val)
        end
        return note_obj("Installed inside the Kali container — size not tracked by apt.")
    end
    if category == "drivers" is
        let pk: [string] = driver_pkgs(name)
        if array_len(pk) == 0 is return note_obj("Unknown driver: " + name) end
        return pkgbackend::show_info(pk[0])
    end
    if category == "hackeros_ecosystem" is
        return note_obj("Managed by the `hacker` CLI (unpack/pack) — size and version aren't tracked here.")
    end
    if category == "dev_tools" is
        let e: DevEntry = dev_tool_entry(name)
        if !e.found is return note_obj("Unknown Dev Tools entry: " + name) end
        if e.is_container is
            return note_obj("Installed inside the hackeros-devbox Podman container — size not tracked by apt on the host.")
        end
        return pkgbackend::show_info(e.pkg)
    end
    let o = jx::ob()
    jx::p_null(o, "size")
    jx::p_null(o, "version")
    return jx::ob_end(o)
end
