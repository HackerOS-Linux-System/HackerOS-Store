    return shx::ok_unit()
end

;; ───────── Pentest ─────────
pub fn install_pentest(name_in: string) -> shx::Res is
    let v: shx::Res = security::validate_pkg_token(name_in)
    if !v.ok is return v end
    let name: string = v.val
    if in_debian(name) is
        let pkg: string = apt_pkg_name(name)
        shx::emit_log("info", "Installing " + name + " from Debian repos...")
        shx::emit_prog("install", "Installing " + name + "...", 0.2)
        let r: shx::Res = apt_install([pkg])
        if !r.ok is return r end
    else
        let a: shx::Res = ensure_distrobox()
        if !a.ok is return a end
        let c1: shx::Res = shx::check_cancel()
        if !c1.ok is return c1 end
        let k: shx::Res = ensure_kali()
        if !k.ok is return k end
        let c2: shx::Res = shx::check_cancel()
        if !c2.ok is return c2 end
        shx::emit_log("info", "Installing " + name + " in Kali container...")
        shx::emit_prog("install", "Installing " + name + " in Kali...", 0.5)
        let r2: shx::Res = shx::run_streaming(["distrobox", "enter", "kali-pentest", "--", "sudo", "apt-get", "install", "-y", name])
        if !r2.ok is return r2 end
        let home: string = shx::home()
        let bin: string = home + "/.local/bin"
        shx::mkdir_p(bin)
        let w: string = bin + "/" + name
        fs::write(w, "#!/bin/sh\ndistrobox enter kali-pentest -- " + name + " \"$@\"\n")
        shx::run(["chmod", "755", w])
        let ddir: string = home + "/.local/share/applications"
        shx::mkdir_p(ddir)
        fs::write(ddir + "/" + name + ".desktop", "[Desktop Entry]\nName=" + name + "\nExec=" + w + "\nType=Application\nCategories=Security;\n")
    end
    shx::emit_prog("done", "Done!", 1.0)
    return shx::ok_unit()
end

pub fn uninstall_pentest(name_in: string) -> shx::Res is
    let v: shx::Res = security::validate_pkg_token(name_in)
    if !v.ok is return v end
    let name: string = v.val
    if in_debian(name) is
        let pkg: string = apt_pkg_name(name)
        shx::emit_log("info", "Removing " + name + " (apt)...")
        shx::emit_prog("uninstall", "Removing " + name + "...", 0.3)
        let r: shx::Res = apt_remove([pkg])
        if !r.ok is return r end
    else
        shx::emit_log("info", "Removing " + name + " from Kali container...")
        shx::emit_prog("uninstall", "Removing " + name + "...", 0.3)
        if kali_exists() is
            shx::run_streaming(["distrobox", "enter", "kali-pentest", "--", "sudo", "apt-get", "remove", "-y", name])
        end
        let home: string = shx::home()
        fs::remove(home + "/.local/bin/" + name)
        fs::remove(home + "/.local/share/applications/" + name + ".desktop")
    end
    shx::emit_prog("done", "Removed.", 1.0)
    return shx::ok_unit()
end

;; ───────── Dev tools ─────────
const PODMAN_ENV: string = "DBX_CONTAINER_MANAGER=podman "

pub fn ensure_podman() -> shx::Res is
    if shx::has("podman") is return shx::ok_unit() end
    shx::emit_log("info", "Installing podman...")
    return apt_install(["podman"])
end

pub fn devbox_exists() -> bool is
    let o: shx::Out = shx::run_env(PODMAN_ENV, ["distrobox", "list"], 0)
    return o.spawned && string_contains(o.stdout, "hackeros-devbox")
end

pub fn ensure_devbox() -> shx::Res is
    if devbox_exists() is return shx::ok_unit() end
    shx::emit_log("info", "Creating the HackerOS Dev Tools container (Podman, first run ~2-3 min)...")
    shx::emit_prog("install", "Creating dev tools container...", 0.15)
    let r: shx::Res = shx::run_streaming_env(["distrobox", "create", "--image", "debian:trixie-slim", "--name", "hackeros-devbox", "--yes"], PODMAN_ENV)
    if !r.ok is return r end
    shx::run_streaming_env(["distrobox", "enter", "hackeros-devbox", "--", "sudo", "apt-get", "update", "-qq"], PODMAN_ENV)
    return shx::ok_unit()
end

pub fn install_dev_tool(name_in: string) -> shx::Res is
    let v: shx::Res = security::validate_display_name(name_in)
    if !v.ok is return v end
    let name: string = v.val
    let e: DevEntry = dev_tool_entry(name)
    if !e.found is return shx::fail("Unknown Dev Tools entry: " + name) end
    if !e.is_container is
        shx::emit_log("info", "Installing " + name + " from Debian repos...")
        shx::emit_prog("install", "Installing " + name + "...", 0.2)
        let r: shx::Res = apt_install([e.pkg])
        if !r.ok is return r end
    else
        let a: shx::Res = ensure_podman()
        if !a.ok is return a end
        let c1: shx::Res = shx::check_cancel()
        if !c1.ok is return c1 end
        let b: shx::Res = ensure_distrobox()
        if !b.ok is return b end
        let c2: shx::Res = shx::check_cancel()
        if !c2.ok is return c2 end
        let d: shx::Res = ensure_devbox()
        if !d.ok is return d end
        let c3: shx::Res = shx::check_cancel()
        if !c3.ok is return c3 end
        shx::emit_log("info", "Installing " + name + " in the dev tools container...")
        shx::emit_prog("install", "Installing " + name + " in container...", 0.6)
        let r2: shx::Res = shx::run_streaming_env(["distrobox", "enter", "hackeros-devbox", "--", "sudo", "apt-get", "install", "-y", e.pkg], PODMAN_ENV)
        if !r2.ok is return r2 end
        let bindir: string = shx::home() + "/.local/bin"
        shx::mkdir_p(bindir)
        let w: string = bindir + "/" + e.bin
        fs::write(w, "#!/bin/sh\nDBX_CONTAINER_MANAGER=podman distrobox enter hackeros-devbox -- " + e.bin + " \"$@\"\n")
        shx::run(["chmod", "755", w])
    end
    shx::emit_prog("done", "Done!", 1.0)
    return shx::ok_unit()
end

pub fn uninstall_dev_tool(name_in: string) -> shx::Res is
    let v: shx::Res = security::validate_display_name(name_in)
    if !v.ok is return v end
    let name: string = v.val
    let e: DevEntry = dev_tool_entry(name)
    if !e.found is return shx::fail("Unknown Dev Tools entry: " + name) end
    if !e.is_container is
        shx::emit_log("info", "Removing " + name + " (apt)...")
        shx::emit_prog("uninstall", "Removing " + name + "...", 0.3)
        let r: shx::Res = apt_remove([e.pkg])
        if !r.ok is return r end
    else
        shx::emit_log("info", "Removing " + name + " from the dev tools container...")
        shx::emit_prog("uninstall", "Removing " + name + "...", 0.3)
        if devbox_exists() is
            shx::run_streaming_env(["distrobox", "enter", "hackeros-devbox", "--", "sudo", "apt-get", "remove", "-y", e.pkg], PODMAN_ENV)
        end
        fs::remove(shx::home() + "/.local/bin/" + e.bin)
    end
    shx::emit_prog("done", "Removed.", 1.0)
    return shx::ok_unit()
end

