pub fn hackeros_ecosystem_marker_dir() -> string is
    return shx::home() + "/.hackeros/ecosystem"
end

pub fn install_hackeros_tool(name: string) -> shx::Res is
    let i: int = idx_of(eco_names(), name)
    if i < 0 is return shx::fail("Unknown HackerOS Ecosystem tool: " + name) end
    let slug: string = eco_slugs()[i]
    shx::emit_log("info", "Unpacking " + name + " (`hacker unpack " + slug + "`)...")
    shx::emit_prog("install", "Installing " + name + "...", 0.2)
    let r: shx::Res = shx::run_streaming(["hacker", "unpack", slug])
    if !r.ok is return r end
    let dir: string = hackeros_ecosystem_marker_dir()
    shx::mkdir_p(dir)
    fs::write(dir + "/" + slug, to_string(time::now_ms() / 1000))
    shx::emit_prog("done", "Done!", 1.0)
    return shx::ok_unit()
end

pub fn uninstall_hackeros_tool(name: string) -> shx::Res is
    let i: int = idx_of(eco_names(), name)
    if i < 0 is return shx::fail("Unknown HackerOS Ecosystem tool: " + name) end
    let slug: string = eco_slugs()[i]
    if !eco_removable()[i] is
        return shx::fail(name + " cannot be removed via `hacker pack` — this is a one-way install.")
    end
    shx::emit_log("info", "Packing " + name + " (`hacker pack " + slug + "`)...")
    shx::emit_prog("uninstall", "Removing " + name + "...", 0.3)
    let r: shx::Res = shx::run_streaming(["hacker", "pack", slug])
    if !r.ok is return r end
    fs::remove(hackeros_ecosystem_marker_dir() + "/" + slug)
    shx::emit_prog("done", "Removed.", 1.0)
    return shx::ok_unit()
end

