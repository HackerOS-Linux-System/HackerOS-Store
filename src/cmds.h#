    if cmd == "nix_check" is return hnm::cmd_nix_check(args) end
    if cmd == "nix_which" is return hnm::cmd_nix_which(args) end
    if cmd == "nix_rollback" is return hnm::cmd_nix_rollback(args) end
    if cmd == "nix_pin" is return hnm::cmd_nix_pin(args) end
    if cmd == "nix_unpin" is return hnm::cmd_nix_unpin(args) end
    if cmd == "nix_gc" is return hnm::cmd_nix_gc(args) end
