    if cmd == "discover_uninstall" is return discover::cmd_discover_uninstall(args) end
    if cmd == "get_installed_sets" is return discover::cmd_get_installed_sets(args) end
    if cmd == "get_app_details" is return discover::cmd_get_app_details(args) end
    if cmd == "get_install_history" is return history::cmd_get_install_history(args) end
    if cmd == "clear_install_history" is return history::cmd_clear_install_history(args) end
    if cmd == "rollback_history_entry" is return history::cmd_rollback_history_entry(args) end
