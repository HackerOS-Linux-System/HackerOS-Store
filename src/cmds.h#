pub fn dispatch(cmd: string, args: string) -> shx::Res is
    if cmd == "refresh_appimage_feed" is return appimage::cmd_refresh_appimage_feed(args) end
    if cmd == "is_brew_available" is return avail::cmd_is_brew_available(args) end
    if cmd == "is_flatpak_available" is return avail::cmd_is_flatpak_available(args) end
    if cmd == "is_snap_available" is return avail::cmd_is_snap_available(args) end
    if cmd == "is_hacker_available" is return avail::cmd_is_hacker_available(args) end
    if cmd == "is_podman_available" is return avail::cmd_is_podman_available(args) end
    if cmd == "is_hpm_available" is return avail::cmd_is_hpm_available(args) end
    if cmd == "is_nix_available" is return avail::cmd_is_nix_available(args) end
    if cmd == "is_apt_available" is return avail::cmd_is_apt_available(args) end
    if cmd == "get_app_info" is return avail::cmd_get_app_info(args) end
    if cmd == "clear_cache" is return avail::cmd_clear_cache(args) end
    if cmd == "check_all_installed" is return ccmds::cmd_check_all_installed(args) end
    if cmd == "get_package_info" is return ccmds::cmd_get_package_info(args) end
    if cmd == "check_updates_available" is return ccmds::cmd_check_updates_available(args) end
    if cmd == "install_package" is return ccmds::cmd_install_package(args) end
    if cmd == "uninstall_package" is return ccmds::cmd_uninstall_package(args) end
    if cmd == "update_system" is return ccmds::cmd_update_system(args) end
    if cmd == "discover_categories" is return discover::cmd_discover_categories(args) end
    if cmd == "discover_browse" is return discover::cmd_discover_browse(args) end
    if cmd == "discover_search" is return discover::cmd_discover_search(args) end
