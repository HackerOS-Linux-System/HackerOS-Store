    if cmd == "submit_rating" is return ratings::cmd_submit_rating(args) end
    if cmd == "get_local_rating" is return ratings::cmd_get_local_rating(args) end
    if cmd == "get_reviews" is return ratings::cmd_get_reviews(args) end
