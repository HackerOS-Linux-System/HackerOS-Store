    if cmd == "save_settings" is return settings::cmd_save_settings(args) end
    if cmd == "reset_settings" is return settings::cmd_reset_settings(args) end
    if cmd == "export_settings_snapshot" is return settings::cmd_export_settings_snapshot(args) end
    if cmd == "import_settings_snapshot" is return settings::cmd_import_settings_snapshot(args) end
    return shx::fail("unknown command: " + cmd)
end
